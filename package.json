{
  "name": "honk-honk",
  "version": "0.4.0",
  "description": "Official Node.js/TypeScript client for Honk! Honk! (honk-honk.app): send events from apps, scripts and automations to your phone, with retries and idempotency built in.",
  "keywords": [
    "honk",
    "honk-honk",
    "notifications",
    "push-notifications",
    "alerts",
    "alerting",
    "monitoring",
    "webhook",
    "inbox",
    "sdk",
    "typescript"
  ],
  "homepage": "https://github.com/honk-hq/node#readme",
  "bugs": {
    "url": "https://github.com/honk-hq/node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/honk-hq/node.git"
  },
  "license": "MIT",
  "author": {
    "name": "Honk! Honk!",
    "email": "accounts@honk-honk.app",
    "url": "https://honk-honk.app"
  },
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "npm run build && node --test test/unit.test.mjs test/cjs.test.cjs",
    "test:integration": "npm run build && node --test test/integration.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
